    "ListEventsOptions": {
      "type": "object",
      "properties": {
        "since_id": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "limit": { "type": "integer", "format": "int32" },
        "before_sequence": { "type": "integer", "format": "int64" },
