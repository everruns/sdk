    "StreamOptions": {
      "type": "object",
      "properties": {
        "since_id": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "max_retries": { "type": "integer", "format": "int32" },
        "idle_timeout_ms": { "type": "integer", "format": "int32" }
      }
    },
    "ToolCallInfo": {
      "type": "object",
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "arguments": { "type": "object" }
      }
    }
